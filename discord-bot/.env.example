# Create a bot application in https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# Must exactly match discordApiSecret in the Runback bundle config.
RUNBACK_API_URL=http://127.0.0.1:9090/runback-discord/api/v1
RUNBACK_API_SECRET=

# Optional comma-separated Discord role IDs allowed to /call and /result.
# Server administrators can always use staff commands.
RUNBACK_ADMIN_ROLE_IDS=

# Required only by the opt-in CSV exporter. Assign this role only to tournament entrants.
DISCORD_EXPORT_ROLE_ID=

# Optional JSON object overriding the call channel for individual Runback event IDs.
# Example: {"event-uuid-1":"discord-channel-id"}
RUNBACK_EVENT_CHANNELS_JSON={}

# Existing matches on stations are not announced when the bot first connects by default.
ANNOUNCE_EXISTING_MATCHES_ON_START=false
POLL_INTERVAL_MS=2000
